// ── FanFilm / Kodi runtime (Chaquopy) ────────────────────────────────────────
// FanFilm is a real Kodi Python addon. It runs inside the app on a CPython
// interpreter provided by Chaquopy; there is no REST shim (AGENTS.md §13).
//
// Python 3.11 is mandatory, not a preference: Chaquopy only ships armeabi-v7a
// and x86 interpreter binaries up to 3.11, and FOX.TV keeps all four ABIs.
chaquopy {
    defaultConfig {
        version = "3.11"

        // Chaquopy needs a host CPython of the same minor version to compile
        // sources and resolve wheels. Resolution order:
        //   1. FOXTV_BUILD_PYTHON (local.properties / env) — explicit override
        //   2. python3.11 / python3 from PATH
        buildPython = buildPythonCommand

        pip {
            // FanFilm's addon.xml requires script.module.requests; everything else
            // it needs is vendored inside the addon (lib/3rd) or supplied as a real
            // Kodi addon under assets/fanfilm/addons.
            install("requests==2.32.3")
            install("urllib3==2.2.3")
            install("certifi==2024.8.30")
            install("charset-normalizer==3.4.0")
            install("idna==3.10")
            // six is imported by cfscrape and several ResolveURL resolvers.
            install("six==1.16.0")
        }

    }
}

// Python sources are compiled by Chaquopy from app/src/main/python.
// The Kodi addon tree itself lives in app/src/main/assets/fanfilm and is
// materialised into filesDir at runtime by FanFilmAssetInstaller: Python needs
// real files on disk (imports, sqlite, settings.xml), which assets are not.
//
// Running the plugin in-tree during development leaves __pycache__/*.pyc behind;
// packaging those would ship stale bytecode, so they are pruned before merging.
val pruneFanFilmBytecode by tasks.registering(Delete::class) {
    val assetsRoot = layout.projectDirectory.dir("src/main/assets/fanfilm")
    delete(
        providers.provider {
            if (!assetsRoot.asFile.exists()) {
                emptyList<java.io.File>()
            } else {
                fileTree(assetsRoot) {
                    include("**/__pycache__/**", "**/*.pyc", "**/*.pyo")
                }.files
            }
        }
    )
}
tasks.matching { it.name.startsWith("merge") && it.name.endsWith("Assets") }.configureEach {
    dependsOn(pruneFanFilmBytecode)
}

// The bridge's pure-Python logic (special:// translation, playback-string normalisation,
// and the Python↔Kotlin contract constants) is unit-tested on the host interpreter — the
// JVM test source set cannot reach it, and a device is not required to verify it.
val nativeAuditReportDirectory = layout.buildDirectory.dir("reports/native-audit")
val nativeAuditJson = nativeAuditReportDirectory.map { it.file("native-audit.json") }
val nativeAuditMarkdown = nativeAuditReportDirectory.map { it.file("native-audit.md") }

val nativeArtifactAudit by tasks.registering(Exec::class) {
    group = "verification"
    description = "Audits pinned local native inputs, ELF policy, and native source contracts."
    workingDir = rootProject.projectDir
    commandLine(
        buildPythonCommand + listOf(
            "tools/native/audit_native_artifacts.py",
            "--root",
            rootProject.projectDir.absolutePath,
            "--lock",
            rootProject.file("tools/native/NATIVE_ARTIFACTS.lock.json").absolutePath,
            "--report-json",
            nativeAuditJson.get().asFile.absolutePath,
            "--report-markdown",
            nativeAuditMarkdown.get().asFile.absolutePath
        )
    )

    inputs.property("pythonCommand", buildPythonCommand)
    inputs.file(rootProject.layout.projectDirectory.file("tools/native/audit_native_artifacts.py"))
    inputs.file(rootProject.layout.projectDirectory.file("tools/native/NATIVE_ARTIFACTS.lock.json"))
    inputs.file(rootProject.layout.projectDirectory.file("settings.gradle.kts"))
    inputs.file(rootProject.layout.projectDirectory.file("app/build.gradle.kts"))
    inputs.file(rootProject.layout.projectDirectory.file("app/src/main/cpp/CMakeLists.txt"))
    inputs.file(rootProject.layout.projectDirectory.file("app/src/main/cpp/dovi_bridge.cpp"))
    inputs.file(
        rootProject.layout.projectDirectory.file(
            "app/src/main/java/com/foxtv/app/core/player/DoviBridge.kt"
        )
    )
    inputs.file(
        rootProject.layout.projectDirectory.file("ffmpeg-decoder-downmix/build.gradle.kts")
    )
    inputs.file(
        rootProject.layout.projectDirectory.file(
            "ffmpeg-decoder-downmix/src/main/jni/CMakeLists.txt"
        )
    )
    inputs.file(
        rootProject.layout.projectDirectory.file(
            "ffmpeg-decoder-downmix/src/main/jni/build_ffmpeg.sh"
        )
    )
    inputs.files(rootProject.fileTree("app/libs") { include("*.aar") })
    inputs.files(rootProject.fileTree("app/src/main/jniLibs") { include("*/*.so") })
    inputs.files(
        rootProject.fileTree("DV7/libdovi") { include("android-*/lib/libdovi.a") }
    )
    outputs.files(nativeAuditJson, nativeAuditMarkdown)
    // Host binutils are part of the evidence boundary but are not copied into the
    // repository. Re-run on every invocation so a stale report cannot mask a tool drift.
    outputs.upToDateWhen { false }
}

val foxtvPythonTest by tasks.registering(Exec::class) {
    group = "verification"
    description = "Runs the FanFilm Python bridge unit tests on the host interpreter."
    workingDir = rootProject.projectDir
    commandLine(buildPythonCommand + listOf("app/src/test/python/test_foxtv_fanfilm.py", "-v"))
    inputs.dir(layout.projectDirectory.dir("src/main/python"))
    inputs.dir(layout.projectDirectory.dir("src/test/python"))
    inputs.file(
        layout.projectDirectory.file(
            "src/main/java/com/foxtv/app/core/fanfilm/FanFilmRuntime.kt"
        )
    )
    outputs.upToDateWhen { false }
}

// Native/source integrity and the Python↔Kotlin bridge are permanent verification gates,
// not variant preBuild hooks. CI also invokes nativeArtifactAudit explicitly because its
// focused build workflows intentionally do not run the complete `check` lifecycle.
tasks.named("check").configure { dependsOn(nativeArtifactAudit, foxtvPythonTest) }

// Globally exclude stock media3 modules — replaced by local :foxtv-exoplayer-engine module
configurations.all {
    exclude(group = "androidx.media3", module = "media3-exoplayer")
    exclude(group = "androidx.media3", module = "media3-common")
    exclude(group = "androidx.media3", module = "media3-datasource")
    exclude(group = "androidx.media3", module = "media3-datasource-okhttp")
    exclude(group = "androidx.media3", module = "media3-exoplayer-hls")
    exclude(group = "androidx.media3", module = "media3-extractor")
}

// AndroidX Baseline Profile 1.4.1 exposes this shared dependency bucket as
// resolvable even though it has no variant attributes and is never consumed directly.
// Keep it declarative-only: releaseBaselineProfile remains resolvable, inherits this
// bucket, and stays covered by strict dependency locking.
configurations.named("baselineProfile") {
    isCanBeResolved = false
}

baselineProfile {
    automaticGenerationDuringBuild = false
    saveInSrc = true
    mergeIntoMain = true
    baselineProfileOutputDir = "generated/baselineProfiles"
    filter {
        include("com.foxtv.app.**")
    }
}

sentry {
    includeProguardMapping.set(true)
    autoUploadProguardMapping.set(sentryMappingUploadEnabled)
    uploadNativeSymbols.set(false)
    autoUploadNativeSymbols.set(false)
    includeNativeSources.set(false)
    includeSourceContext.set(false)
    autoUploadSourceContext.set(false)
    includeDependenciesReport.set(false)
    telemetry.set(false)
    sentryAuthToken?.let(authToken::set)
    sentryOrg?.let(org::set)
    sentryProject?.let(projectName::set)
    ignoredBuildTypes.set(setOf("debug"))
    autoInstallation {
        enabled.set(false)
    }
    tracingInstrumentation {
        enabled.set(false)
    }
}

dependencies {
    coreLibraryDesugaring(libs.desugar.jdk.libs)

    // Source-retention nullness annotations (MonotonicNonNull / RequiresNonNull /
    // EnsuresNonNull) used by the vendored Matroska extractor in
    // com.foxtv.app.core.player.dvmkv. Media3 keeps these compileOnly in its own
    // build, so they aren't on our classpath via the prebuilt AARs.
    compileOnly(libs.checker.qual)

    baselineProfile(project(":baselineprofile"))
    implementation(libs.androidx.core.ktx)
    implementation(libs.androidx.core.splashscreen)
    implementation(libs.androidx.appcompat)
    implementation(libs.androidx.profileinstaller)
    implementation(libs.androidx.recyclerview)
    implementation(platform(libs.androidx.compose.bom))
    implementation(libs.androidx.compose.ui)
    implementation(libs.androidx.compose.ui.graphics)
    implementation(libs.androidx.compose.ui.tooling.preview)
    implementation(libs.androidx.compose.material3)
    implementation(libs.androidx.compose.foundation)
    implementation(libs.androidx.compose.material.icons.extended)
    implementation(libs.androidx.tv.material)
    implementation(libs.androidx.tvprovider)
    implementation(libs.androidx.lifecycle.runtime.ktx)
    implementation(libs.androidx.activity.compose)

    // Hilt
    implementation(libs.hilt.android)
    ksp(libs.hilt.compiler)
    implementation(libs.hilt.navigation.compose)

    // Aniyomi Jellyfin 14.17 parent-owned host ABI. extensions-lib is intentionally
    // not packaged because it contains compile-time throwing stubs.
    implementation(libs.androidx.preference.ktx)
    // Injekt commit 65b04400 is vendored as Kotlin source because its thread-safety fix
    // was never published and JitPack cannot build the historical Gradle 2 project.
    implementation(libs.rxjava1)

    // Networking
    implementation(libs.retrofit)
    implementation(libs.retrofit.moshi)
    implementation(libs.okhttp)
    implementation(libs.okhttp.logging)
    implementation(libs.moshi)
    ksp(libs.moshi.codegen)

    // Coroutines
    implementation(libs.coroutines.core)
    implementation(libs.coroutines.android)

    // Image Loading
    implementation(libs.coil.compose)
    implementation(libs.coil.gif)
    implementation(libs.coil.svg)
    implementation(libs.coil.network.okhttp)
    implementation(libs.coil.network.cache.control)
    implementation(libs.lottie.compose)

    // Navigation
    implementation(libs.navigation.compose)

    // DataStore
    implementation(libs.datastore.preferences)

    // ViewModel
    implementation(libs.androidx.lifecycle.viewmodel.compose)

    // Media3 — remaining stock modules from Maven (not forked)
    implementation(libs.media3.exoplayer.hls)
    implementation(libs.media3.exoplayer.dash)
    implementation(libs.media3.exoplayer.smoothstreaming)
    implementation(libs.media3.exoplayer.rtsp)
    implementation(libs.media3.decoder)
    implementation(libs.media3.session)
    implementation(libs.media3.container)

    // Transitive dependencies required by forked local AARs (not bundled in AARs):
    // - Guava: needed by lib-common (ImmutableList/ImmutableSet in Tracks, Player API)
    // - media3-database: needed by lib-datasource (cache/storage layer)
    // - annotation-experimental: needed by lib-common (OptIn annotations)
    implementation(libs.guava.android)
    implementation(libs.media3.database)
    implementation(libs.androidx.annotation.experimental)

    // FoxTv Engine local AARs (replaces lib-exoplayer, lib-common, lib-datasource, lib-datasource-okhttp, lib-exoplayer-hls, lib-extractor)
    implementation(files(
        "libs/lib-common-release.aar",
        "libs/lib-datasource-release.aar",
        "libs/lib-datasource-okhttp-release.aar",
        "libs/lib-exoplayer-release.aar",
        "libs/lib-exoplayer-hls-release.aar",
        "libs/lib-extractor-release.aar"
    ))
    implementation(libs.media3.ui)

    // Local decoder AARs (AV1, IAMF, MPEG-H)
    implementation(files(
        "libs/lib-decoder-av1-release.aar",
        "libs/lib-decoder-mpegh-release.aar"
    ))
    implementation(files("libs/lib-decoder-iamf-release.aar"))
    if (useLocalFfmpegDecoder) {
        implementation(project(":ffmpeg-decoder-downmix"))
    } else {
        implementation(files("libs/lib-decoder-ffmpeg-release.aar"))
    }

    // libass-android for ASS/SSA subtitle support (from Maven Central)
    implementation(libs.ass.media)
    // Local nextlib-mediainfo fork (static FFmpeg; no libav*.so in final AAR)
    implementation(files("libs/nextlib-mediainfo-local.aar"))
    implementation(libs.mpv.android)
    implementation(libs.haze.android) {
        exclude(group = "org.jetbrains.compose.ui")
        exclude(group = "org.jetbrains.compose.foundation")
    }

    implementation(libs.gson)

    implementation(files("libs/quickjs-kt-android-1.0.5-playtorrio.aar"))
    implementation(libs.jsoup)
    implementation(libs.jackson.databind)
    implementation(libs.jackson.module.kotlin)
    implementation(libs.nicehttp)
    implementation(libs.conscrypt.android)
    // Cloudstream's ExtractorApi registry initializes Rhino classes at runtime. Keep the
    // upstream v4.7.0 Android-compatible pin (1.9+ raises the runtime requirement).
    implementation(libs.rhino)
    implementation(libs.cloudstream.library) {
        exclude(group = "org.mozilla", module = "rhino")
        exclude(group = "com.github.AmarullisVFX", module = "newpipeextractor")
        exclude(group = "com.github.AmaryllisVFX", module = "newpipeextractor")
        exclude(group = "com.github.AmaryllisVFX.newpipeextractor")
        exclude(group = "info.debatty", module = "java-string-similarity")
    }

    // Markdown rendering
    implementation(libs.markdown.renderer.m3)

    implementation(libs.crypto.js)
    // QR code + local server for addon management
    implementation(libs.nanohttpd)
    implementation(libs.zxing.core)

    // Supabase
    implementation(platform(libs.supabase.bom))
    implementation(libs.supabase.auth)
    implementation(libs.supabase.postgrest)
    implementation(libs.supabase.storage)
    implementation(libs.ktor.client.okhttp)
    implementation(libs.sentry.android)

    // Kotlinx Serialization
    implementation(libs.kotlinx.serialization.json)

    // Performance profiling
    implementation(libs.androidx.metrics.performance) // JankStats
    debugImplementation(libs.androidx.compose.runtime.tracing)

    androidTestImplementation(platform(libs.androidx.compose.bom))
    androidTestImplementation(libs.androidx.compose.ui.test.junit4)
    androidTestImplementation(libs.androidx.test.ext.junit)
    androidTestImplementation(libs.androidx.test.runner)
    testImplementation(libs.junit4)
    testImplementation(libs.coroutines.test)
    testImplementation(libs.mockk)
    testImplementation(libs.okhttp.mockwebserver)
    testImplementation(libs.okhttp.tls)
    debugImplementation(libs.androidx.compose.ui.tooling)
    debugImplementation(libs.androidx.compose.ui.test.manifest)
}

// Runtime javac in the controlled M3 fixture must see the exact Gradle test classpath.
// Resolve it immediately before the Test action so Android variant wiring is already complete.
tasks.withType<Test>().configureEach {
    doFirst {
        systemProperty("foxtv.test.runtimeClasspath", classpath.asPath)
    }
}

/**
 * Host interpreter used by Chaquopy to byte-compile sources and resolve wheels.
 * It must be CPython 3.11 to match the interpreter packaged into the APK.
 *
 * Resolution order: FOXTV_BUILD_PYTHON (local.properties / env) → python3.11 on
 * PATH → python3 on PATH. Each candidate is probed for a 3.11 version string so a
 * mismatched default python3 does not silently produce bytecode the device cannot
 * load. If nothing matches we hand Chaquopy "python3.11" so the failure names the
 * missing tool instead of surfacing as a magic-number error at runtime.
 */
val buildPythonCommand: List<String> = run {
    fun probe(command: String): Boolean = runCatching {
        val process = ProcessBuilder(command, "--version")
            .redirectErrorStream(true)
            .start()
        val output = process.inputStream.bufferedReader().readText().trim()
        process.waitFor()
        process.exitValue() == 0 && output.contains("3.11")
    }.getOrDefault(false)

    val candidates = buildList {
        resolveProperty(devProperties, localProperties, "FOXTV_BUILD_PYTHON")
            .takeIf { it.isNotBlank() }
            ?.let { add(it) }
        add("python3.11")
        add("python3")
    }
    listOf(candidates.firstOrNull(::probe) ?: "python3.11")
}

